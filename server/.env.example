PORT=4000

# "1" skips store calls and grants entitlements from the request payload.
IAP_MOCK=1

# Signs session tokens. Required when IAP_MOCK is not 1 (generate with: openssl rand -base64 32).
SESSION_SECRET=

# debug | info | warn | error | silent. Defaults to debug when IAP_MOCK=1, otherwise info.
LOG_LEVEL=

# Products /verify will accept.
PRODUCT_IDS=flamingo_premium_monthly,flamingo_premium_yearly

# Apple App Store Server API (App Store Connect > Users and Access > Integrations > In-App Purchase)
APPLE_BUNDLE_ID=com.flamingo.paywalldemo
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./keys/SubscriptionKey.p8
APPLE_APP_APPLE_ID=
# Directory of Apple root certificates (AppleRootCA-G3.cer etc.) used to verify signed JWS payloads.
APPLE_ROOT_CERTS_DIR=./keys/apple-roots
# Sandbox | Production
APPLE_ENVIRONMENT=Sandbox

# Google Play Developer API (service account with "View financial data" + "Manage orders")
GOOGLE_PACKAGE_NAME=com.flamingo.paywalldemo
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./keys/play-service-account.json
# Pub/Sub push subscription with authentication enabled: the audience set on the subscription
# and the service account Pub/Sub signs tokens as.
GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT=rtdn-push@your-project.iam.gserviceaccount.com
